# OrbStack's include must precede Host blocks.
Include ~/.orbstack/ssh/config
Include ~/.ssh/work.config

Host forgejo.home.pawelprotas.com
    User git
    IdentityFile ~/.ssh/forgejo-personal.pub
    IdentitiesOnly yes

Host github.com github-personal
    HostName github.com
    User git
    IdentityFile ~/.ssh/github-personal.pub
    IdentitiesOnly yes

Host *
    IdentityAgent SSH_AUTH_SOCK
