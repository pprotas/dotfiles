[user]
  name = Pawel Protas
  email = contact@pawelprotas.com
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAwszij0fuhnHIxtnjRrXo/njqLWST7lB9zqL+FvbKR8
[core]
  excludesfile = ~/.gitignore_global
[init]
  defaultBranch = main

[gpg]
  format = ssh
[commit]
  gpgsign = true

[pull]
  ff = only

[push]
  autoSetupRemote = true
  forceWithLease = true

[rebase]
  updateRefs = true
  autoStash = true
[rerere]
  enabled = true

[diff]
  mnemonicPrefix = true
  colorMoved = zebra
  compactionHeuristic = true

[grep]
  lineNumber = true
  patternType = perl
  extendedRegexp = true

[help]
  autocorrect = prompt

[alias]
  s = "!git for-each-ref --sort=-committerdate refs/heads/ --format='%(refname:short)' | fzf --reverse --height=20% --info=inline | xargs git checkout"

[include]
  path = ~/.gitconfig_h1
