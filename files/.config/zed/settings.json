//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "right",
  },
  "diff_view_style": "unified",
  "edit_predictions": {
    "provider": "copilot",
  },
  "agent_servers": {
    "pi-acp": {
      "default_model": "amazon-bedrock/global.anthropic.claude-opus-4-7",
      "type": "registry",
    },
    "opencode": {
      "type": "registry",
    },
    "claude-acp": {
      "default_config_options": {
        "model": "opus[1m]",
      },
      "type": "registry",
    },
  },
  "git_panel": {
    "dock": "right",
    "tree_view": true,
  },
  "sticky_scroll": {
    "enabled": true,
  },
  "debugger": {
    "timeout": 10000,
  },
  "language_models": {
    "bedrock": {
      "authentication_method": "sso",
      "region": "us-west-2",
      "profile": "default",
    },
  },
  "languages": {
    "TypeScript": {
      "code_actions_on_format": {
        "source.organizeImports": true,
        "source.fixAll": true,
        "source.fixAll.eslint": true,
      },
    },
    "TSX": {
      "code_actions_on_format": {
        "source.organizeImports": true,
        "source.fixAll": true,
        "source.fixAll.eslint": true,
      },
    },
    "JavaScript": {
      "code_actions_on_format": {
        "source.organizeImports": true,
        "source.fixAll": true,
        "source.fixAll.eslint": true,
      },
    },
  },
  // Editor
  "ssh_connections": [
    {
      "host": "gitlab.inverselink.com",
      "args": [],
      "projects": [],
    },
    {
      "host": "192.168.50.138",
      "username": "pawel",
      "args": [],
      "projects": [],
    },
    {
      "host": "192.168.50.138",
      "username": "pawel",
      "args": [],
      "projects": [],
    },
    {
      "host": "192.168.50.138",
      "username": "pawel",
      "args": [],
      "projects": [],
    },
    {
      "host": "192.168.50.138",
      "username": "pawel",
      "args": [],
      "projects": [],
    },
    {
      "host": "192.168.50.138",
      "username": "pawel",
      "args": [],
      "projects": [],
    },
    {
      "host": "192.168.50.138",
      "username": "pawel",
      "args": [],
      "projects": [],
    },
  ],
  "diagnostics": {
    "inline": {
      "enabled": false,
    },
  },
  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": true,
    "use_smartcase_find": true,
  },
  "autosave": "on_focus_change",
  "auto_signature_help": true,
  "use_smartcase_search": true,
  // UI
  "icon_theme": "Colored Zed Icons Theme Dark",
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Vercel Dark",
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "activate_on_close": "history",
    "show_close_button": "hover",
    "show_diagnostics": "all",
  },
  "use_system_window_tabs": true,
  "pane_split_direction_horizontal": "down",
  "pane_split_direction_vertical": "right",
  "minimap": {
    "show": "auto",
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "indent_guides": {
    "coloring": "fixed",
  },
  "colorize_brackets": true,
  "soft_wrap": "editor_width",
  "outline_panel": { "dock": "right", "button": false },
  "collaboration_panel": { "dock": "right", "button": false },
  "which_key": { "enabled": true, "delay_ms": 0 },
  // LSP
  "go_to_definition_fallback": "none",
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "preferences": {
            "importModuleSpecifier": "non-relative",
          },
        },
        "javascript": {
          "preferences": {
            "importModuleSpecifier": "non-relative",
          },
        },
      },
    },
  },
  "inlay_hints": {
    "enabled": false,
    "show_value_hints": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true,
    "show_background": false,
    "edit_debounce_ms": 700,
    "scroll_debounce_ms": 50,
    "toggle_on_modifiers_press": {
      "control": false,
      "alt": false,
      "shift": false,
      "platform": false,
      "function": false,
    },
  },
  "agent": {
    "show_merge_conflict_indicator": false,
    "dock": "left",
    "default_profile": "write",
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "amazon-bedrock",
      "model": "claude-opus-4-6",
    },
  },
}
